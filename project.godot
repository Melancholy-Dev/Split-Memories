; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Split Memories"
run/main_scene="uid://cxuba5jas6jti"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LitManager="*uid://brf2hvdtyyw3q"
PhantomCameraManager="*uid://duq6jhf6unyis"
InputManager="*uid://bscugmxnxur15"
UndoManager="*uid://cjqi53j5xmbb7"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdscript_formatter/plugin.cfg", "res://addons/lit/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "green",
"res://assets/audio/": "teal",
"res://assets/fonts/": "teal",
"res://resources/": "red",
"res://scenes/": "yellow",
"res://scripts/": "blue"
}

[global_group]

scene_manager=""
audio_manager=""
animation_manager=""

